# Telegram Bot Token nhận từ @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID cá nhân hoặc Group ID (ví dụ: 123456789 hoặc -100123456789)
TELEGRAM_CHAT_ID=123456789

# Khóa bảo mật để chống người lạ spam gọi URL API trên Vercel (Tùy chọn nhưng nên có)
CRON_SECRET=my_super_secret_token_123

# Mức độ ảnh hưởng tối thiểu của tin tức: "High", "Medium", hoặc "Low" (Mặc định: Medium)
MIN_IMPACT=Medium

# Danh sách các đồng tiền theo dõi (cách nhau bởi dấu phẩy)
CURRENCIES=USD,EUR,GBP,JPY,CAD,AUD,NZD,CHF

# Múi giờ hiển thị (Mặc định: Asia/Ho_Chi_Minh cho giờ Việt Nam)
TIMEZONE=Asia/Ho_Chi_Minh

# Số phút quét trước giờ ra tin (Mặc định: 30)
WINDOW_MINUTES=30
